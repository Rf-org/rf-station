# Copy to .env for local dev. Never put API keys here — the kiosk holds no secrets,
# only the station token (obtained via staff registration, stored in localStorage).
VITE_BACKEND_WS=wss://backend.example.com
VITE_BACKEND_HTTP=https://backend.example.com
VITE_PTT_KEY=Space
VITE_APP_VERSION=0.1.0
VITE_CONSENT_VERSION=1
VITE_QB_VERSION=1
